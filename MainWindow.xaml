<Window x:Class="TinyStopwatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tiny Stopwatch"
        Icon="stopwatch.ico"
        Width="200" Height="54"
        MinWidth="160"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#18000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        Root Grid layers the card and the invisible right-edge resize strip.
        Padding on the right keeps content clear of the resize zone.
    -->
    <Grid>

        <!-- Floating card -->
        <Border Background="#FFFFFF"
                CornerRadius="10"
                BorderBrush="#D8D8D8" BorderThickness="1"
                Margin="0,0,6,0"
                MouseLeftButtonDown="DragBar_MouseDown">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.14"
                                  BlurRadius="14" ShadowDepth="3"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Border Grid.Row="0"
                        Background="#F5F5F5"
                        CornerRadius="10,10,0,0"
                        BorderBrush="#EBEBEB" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="Stopwatch"
                                   FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold"
                                   Foreground="#ABABAB"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Content="✕" Style="{StaticResource ChromeBtn}"
                                FontFamily="Segoe UI" FontSize="9"
                                Foreground="#CACACA"
                                Width="18" Height="14"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                Click="HideWindow_Click"/>
                    </Grid>
                </Border>

                <!-- Controls row -->
                <Grid Grid.Row="1" Margin="8,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- ▶ / ⏸ -->
                    <Button x:Name="PlayPauseBtn" Grid.Column="0"
                            Style="{StaticResource FlatBtn}"
                            Click="PlayPause_Click"
                            ToolTip="Start / Pause  (Space)">
                        <TextBlock x:Name="PlayPauseIcon" Text="▶"
                                   FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#1C1C1C"/>
                    </Button>

                    <!-- ↺ -->
                    <Button x:Name="ResetBtn" Grid.Column="1"
                            Style="{StaticResource FlatBtn}"
                            IsEnabled="False"
                            Click="Reset_Click"
                            Margin="1,0,0,0"
                            ToolTip="Reset — saves session to history">
                        <TextBlock Text="↺" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#1C1C1C"/>
                    </Button>

                    <!-- Separator -->
                    <Border Grid.Column="2" Width="1" Background="#E0E0E0"
                            VerticalAlignment="Center" Height="14" Margin="6,0"/>

                    <!-- Timer -->
                    <TextBlock x:Name="TimerDisplay" Grid.Column="3"
                               Text="00:00"
                               FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                               Foreground="#1C1C1C"
                               VerticalAlignment="Center"
                               Margin="3,0,0,0"/>

                    <!-- ☰ history -->
                    <Button Grid.Column="5"
                            Style="{StaticResource FlatBtn}"
                            Click="History_Click"
                            ToolTip="View session history">
                        <TextBlock Text="☰" FontFamily="Segoe UI" FontSize="11"
                                   Foreground="#1C1C1C"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Invisible right-edge handle — drag here to resize width -->
        <Border HorizontalAlignment="Right" Width="10"
                Background="Transparent"
                Cursor="SizeWE"
                MouseLeftButtonDown="ResizeRight_MouseDown"/>

    </Grid>
</Window>
