<Window x:Class="TinyStopwatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tiny Stopwatch"
        Width="250" Height="148"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Round icon button used for Play/Pause, Reset, History -->
        <Style x:Key="RoundBtn" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#1C1C30"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28283C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#35355A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Transparent text-only close button -->
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#44445A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="3,1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#9999BB"/>
                                <Setter Property="Background" Value="#252535"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer container: rounded dark card with shadow -->
    <Border Background="#0F0F1E" CornerRadius="18"
            BorderBrush="#252540" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.7"
                              BlurRadius="20" ShadowDepth="5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- ── Title bar (drag zone) ─────────────────────── -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="DragBar_MouseDown">
                <TextBlock Text="S T O P W A T C H"
                           FontFamily="Segoe UI" FontSize="8" FontWeight="SemiBold"
                           Foreground="#33334A"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Content="✕" Style="{StaticResource CloseBtn}"
                        FontSize="11" Width="22" Height="18"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Click="HideWindow_Click"/>
            </Grid>

            <!-- ── Timer display ─────────────────────────────── -->
            <TextBlock x:Name="TimerDisplay" Grid.Row="1"
                       Text="00:00.0"
                       FontFamily="Consolas" FontSize="32" FontWeight="Bold"
                       Foreground="#00D4FF"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#00AAFF" Opacity="0.55"
                                      BlurRadius="12" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- ── Controls row ──────────────────────────────── -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,0,0,4">

                <!-- Play / Pause -->
                <Button x:Name="PlayPauseBtn"
                        Style="{StaticResource RoundBtn}"
                        BorderBrush="#00D4FF"
                        Click="PlayPause_Click"
                        Margin="5,0"
                        ToolTip="Start / Pause (Space)">
                    <TextBlock x:Name="PlayPauseIcon" Text="▶"
                               FontSize="15" Foreground="#00D4FF"
                               Margin="3,0,0,0"/>
                </Button>

                <!-- Reset (saves to history) -->
                <Button x:Name="ResetBtn"
                        Style="{StaticResource RoundBtn}"
                        BorderBrush="#FF6B6B"
                        IsEnabled="False"
                        Click="Reset_Click"
                        Margin="5,0"
                        ToolTip="Reset — saves current time to history">
                    <TextBlock Text="↺" FontSize="20" Foreground="#FF6B6B"/>
                </Button>

                <!-- History shortcut -->
                <Button Style="{StaticResource RoundBtn}"
                        BorderBrush="#5A5A7A"
                        Click="History_Click"
                        Margin="5,0"
                        ToolTip="View session history">
                    <TextBlock Text="☰" FontSize="15" Foreground="#5A5A7A"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
