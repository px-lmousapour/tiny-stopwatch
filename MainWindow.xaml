<Window x:Class="TinyStopwatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tiny Stopwatch"
        Height="44"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#F3F3F3"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Top border acts as a visible separator from content above -->
    <Border BorderBrush="#C8C8C8" BorderThickness="0,1,0,0"
            Background="#F3F3F3"
            MouseLeftButtonDown="DragBar_MouseDown">

        <Grid Margin="10,0,8,0">
            <Grid.ColumnDefinitions>
                <!-- Play / Pause -->
                <ColumnDefinition Width="Auto"/>
                <!-- Reset -->
                <ColumnDefinition Width="Auto"/>
                <!-- Thin separator -->
                <ColumnDefinition Width="1"/>
                <!-- Timer -->
                <ColumnDefinition Width="Auto"/>
                <!-- Flexible spacer -->
                <ColumnDefinition Width="*"/>
                <!-- History -->
                <ColumnDefinition Width="Auto"/>
                <!-- Hide -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ▶ / ⏸ -->
            <Button x:Name="PlayPauseBtn" Grid.Column="0"
                    Style="{StaticResource FlatBtn}"
                    Click="PlayPause_Click"
                    ToolTip="Start / Pause  (Space)">
                <TextBlock x:Name="PlayPauseIcon" Text="▶"
                           FontFamily="Segoe UI" FontSize="10"
                           Foreground="#0078D4"/>
            </Button>

            <!-- ↺ reset -->
            <Button x:Name="ResetBtn" Grid.Column="1"
                    Style="{StaticResource FlatBtn}"
                    IsEnabled="False"
                    Click="Reset_Click"
                    Margin="2,0,0,0"
                    ToolTip="Reset — saves session to history">
                <TextBlock Text="↺" FontFamily="Segoe UI" FontSize="13"
                           Foreground="#C42B1C"/>
            </Button>

            <!-- Vertical separator -->
            <Border Grid.Column="2" Width="1" Background="#D4D4D4"
                    VerticalAlignment="Center" Height="18" Margin="8,0"/>

            <!-- Timer digits — same Segoe UI size as taskbar clock -->
            <TextBlock x:Name="TimerDisplay" Grid.Column="3"
                       Text="00:00.0"
                       FontFamily="Segoe UI" FontSize="12"
                       Foreground="#1C1C1C"
                       VerticalAlignment="Center"
                       Margin="4,0,0,0"/>

            <!-- History button -->
            <Button Grid.Column="5" Style="{StaticResource FlatBtn}"
                    Click="History_Click"
                    ToolTip="View session history">
                <TextBlock Text="☰" FontFamily="Segoe UI" FontSize="10"
                           Foreground="#767676"/>
            </Button>

            <!-- Hide-to-tray -->
            <Button Grid.Column="6" Style="{StaticResource FlatBtn}"
                    Click="HideWindow_Click"
                    Margin="2,0,0,0"
                    ToolTip="Hide to tray">
                <TextBlock Text="✕" FontFamily="Segoe UI" FontSize="9"
                           Foreground="#767676"/>
            </Button>
        </Grid>
    </Border>
</Window>
