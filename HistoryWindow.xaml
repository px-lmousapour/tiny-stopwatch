<Window x:Class="TinyStopwatch.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session History"
        Width="340" Height="440"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#767676"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="4,2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15000000"/>
                                <Setter Property="Foreground" Value="#1C1C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Light card with subtle shadow -->
    <Border Background="#FFFFFF" CornerRadius="12"
            BorderBrush="#DEDEDE" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.12"
                              BlurRadius="24" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header / drag zone -->
            <Border Grid.Row="0" Background="#F3F3F3"
                    BorderBrush="#E5E5E5" BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="Header_MouseDown">
                <Grid>
                    <TextBlock Text="Session History"
                               FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                               Foreground="#1C1C1C"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="✕" Style="{StaticResource CloseBtn}"
                            FontFamily="Segoe UI" FontSize="11"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Click="CloseWindow_Click"/>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1">
                <!-- Empty state -->
                <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="⏱" FontSize="32" Foreground="#D0D0D0"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="No sessions recorded yet."
                               FontFamily="Segoe UI" FontSize="13"
                               Foreground="#767676" HorizontalAlignment="Center"/>
                    <TextBlock Text="Press ▶ then ↺ to save your first session."
                               FontFamily="Segoe UI" FontSize="11"
                               Foreground="#ABABAB" HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Session list -->
                <ScrollViewer x:Name="ListScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,4,0,8">
                    <ItemsControl x:Name="HistoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1"
                                        Padding="18,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding FormattedDuration}"
                                                   FontFamily="Segoe UI" FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0078D4"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Date, StringFormat='ddd MMM d  HH:mm'}"
                                                   FontFamily="Segoe UI" FontSize="11"
                                                   Foreground="#ABABAB"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
